{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "cmake: configure and build latest",
      "type": "process",
      "command": "/usr/bin/bash",
      "args": [
        "${workspaceFolder}/.vscode/cmake-build.sh"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": "$gcc",
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "presentation": {
        "reveal": "silent",
        "panel": "dedicated",
        "clear": true
      },
      "runOptions": {
        "instanceLimit": 1
      }
    }
  ]
}
